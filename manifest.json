{
  "manifest_version": 3,
  "name": "Sakura for Claude",
  "version": "1.0.0",
  "description": "A blooming reskin for Claude.ai — falling petals, a day/night sky, pixel-art scenery, and re-colored chat. First of a series of Claude themes.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "src/theme-engine.js",
        "src/petals.js",
        "src/companions.js",
        "src/toggle.js",
        "src/content.js"
      ],
      "css": ["styles/inject.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/backgrounds/*", "assets/icons/*", "assets/sprites/*"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}
